# Google Places API (New) key. Only needed for the `verify` step.
GOOGLE_PLACES_API_KEY=

# Hard cap on Google Text Search calls per calendar month (Enterprise tier: websiteUri).
# Keep it under the free monthly allowance shown in Google's pricing page.
GOOGLE_MONTHLY_CALL_CAP=900

DB_PATH=mapsleads.db
# Overpass mirror; the public instance is free but rate limited.
OVERPASS_URL=https://overpass-api.de/api/interpreter
